# FoxProfile configuration (copy to .env to override defaults)

# Interface language: en (default) or vi
FOXPROFILE_LANG=en

# Profile storage file
FOXPROFILE_PROFILES_FILE=profiles.json

# Directory that page uploads may read from (tqd-browser); files elsewhere are refused
TQD_UPLOAD_DIR=media_outbox

# --- tqd_automation (posting macros) ---
# API the automation client talks to
# FOXPROFILE_URL=http://127.0.0.1:8000
# Optional TypeSafe judge (pip install -r requirements-automation.txt). Prefer setting the key as an
# OS user environment variable rather than in this file.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=
# 1 stops all posting (same as creating automation_data/KILL)
# TQD_AUTOMATION_DISABLED=0
# true makes macros stop before publishing and ask for approval
# TQD_REQUIRE_APPROVAL=false
# Sent posts per local day (Asia/Ho_Chi_Minh) and minimum minutes between posts
# TQD_FACEBOOK_DAILY_CAP=3
# TQD_TIKTOK_DAILY_CAP=2
# TQD_MIN_INTERVAL_MIN=90

# Browser data directory (one sub-folder per profile, holds cookies + fingerprint)
FOXPROFILE_DATA_DIR=camoufox_data

# Log directory
FOXPROFILE_LOG_DIR=logs

# Log level (DEBUG, INFO, WARNING, ERROR)
FOXPROFILE_LOG_LEVEL=INFO

# Proxy check timeout in seconds
FOXPROFILE_PROXY_TIMEOUT=10

# Seconds the launch API waits for the browser to be ready
FOXPROFILE_LAUNCH_TIMEOUT=90

# Run browsers hidden: true, false or virtual (Linux + Xvfb). Server mode defaults to true.
# FOXPROFILE_HEADLESS=false

# Reopen the tabs a profile had open when it was last stopped (default true).
# FOXPROFILE_RESTORE_TABS=true

# Token for the API, web panel and MCP. Required when API_HOST is not 127.0.0.1.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FOXPROFILE_API_TOKEN=

# Local API settings
FOXPROFILE_API_HOST=127.0.0.1
FOXPROFILE_API_PORT=8000
