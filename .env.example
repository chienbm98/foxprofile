# FoxProfile configuration (copy to .env to override defaults)

# Interface language: vi (default) or en
FOXPROFILE_LANG=vi

# Profile storage file
FOXPROFILE_PROFILES_FILE=profiles.json

# Browser data directory (one sub-folder per profile, holds cookies + fingerprint)
FOXPROFILE_DATA_DIR=camoufox_data

# Log directory
FOXPROFILE_LOG_DIR=logs

# Log level (DEBUG, INFO, WARNING, ERROR)
FOXPROFILE_LOG_LEVEL=INFO

# Proxy check timeout in seconds
FOXPROFILE_PROXY_TIMEOUT=10

# Seconds the launch API waits for the browser to be ready
FOXPROFILE_LAUNCH_TIMEOUT=90

# Local API settings. The API has no authentication: keep it on 127.0.0.1.
FOXPROFILE_API_HOST=127.0.0.1
FOXPROFILE_API_PORT=8000
